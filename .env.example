# 《圣经》文体翻译器 · 服务端模型路由配置
#
# 本项目默认使用 BYOK（用户自带 Key）：
# - 用户在网页中填写自己的 DeepSeek API Key。
# - Key 只保存在用户当前浏览器，并随单次请求临时传给服务端代理。
# - 服务端不需要、也不应配置公共 DEEPSEEK_API_KEY。

# OpenAI 兼容接口基础地址，结尾不要带 /chat/completions。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 初稿模型与事实审校模型。
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REVIEW_MODEL=deepseek-chat

# 单次输出上限。
MAX_OUTPUT_TOKENS=4096

# 整次翻译的时间预算与单次模型调用上限（毫秒）。
# 原文成章只做元素识别；JSON 无效最多重试一次，随后返回本地紧急版本。
TRANSLATE_TIME_BUDGET_MS=45000
DEEPSEEK_CALL_TIMEOUT_MS=22000
