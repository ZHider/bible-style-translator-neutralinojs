# 《圣经》文体翻译器 · 服务端模型路由配置
#
# 本项目默认使用 BYOK（用户自带 Key）：
# - 用户在网页中填写与站点接口相匹配的 API Key，并可选填模型名。
# - Key 只保存在用户当前浏览器，并随单次请求临时传给服务端代理。
# - 服务端不需要、也不应配置公共 DEEPSEEK_API_KEY。

# 推荐使用通用变量配置任意 OpenAI 兼容接口，结尾不要带 /chat/completions。
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# 可选：接口错误没有返回可用模型名时，按顺序尝试这些模型。
AI_MODEL_CANDIDATES=deepseek-v4-flash,deepseek-v4-pro

# 旧版变量仍然兼容；通用变量未配置时才读取它们。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_CANDIDATES=deepseek-v4-flash,deepseek-v4-pro

# 单次输出上限。
MAX_OUTPUT_TOKENS=4096

# 整次翻译的时间预算与单次模型调用上限（毫秒）。
# 原文成章只做元素识别；JSON 无效最多重试一次，随后返回本地紧急版本。
TRANSLATE_TIME_BUDGET_MS=45000
DEEPSEEK_CALL_TIMEOUT_MS=22000
