{
  "applicationId": "com.lizi605.biblestyletranslator",
  "version": "1.1.1",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "documentRoot": "/resources/",
  "enableServer": true,
  "enableNativeAPI": true,
  "singlePageServe": true,
  "logging": {
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "net.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "《圣经》文体翻译器",
      "width": 1440,
      "height": 960,
      "minWidth": 980,
      "minHeight": 700,
      "icon": "/resources/images/icon.png",
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "bible-style-translator",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/neutralino.js",
    "extensions": []
  }
}
