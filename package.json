{
  "name": "bible-style-translator",
  "version": "1.1.1",
  "description": "保留任意现代中文文案的原意与结构，将其改写成故意庄严过度的和合本翻译腔。",
  "type": "module",
  "author": "圣经体翻译器",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "public:audit": "node scripts/public-audit.mjs",
    "desktop:build": "NEXT_PUBLIC_DESKTOP=true next build && node scripts/prepare-neutralino-assets.mjs",
    "desktop:run": "pnpm desktop:build && pnpx @neutralinojs/neu run",
    "desktop:dist": "pnpm desktop:build && pnpx @neutralinojs/neu build --release",
    "cf:build": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "lucide-react": "^1.25.0",
    "next": "15.5.21",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "wrangler": "^4.103.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
